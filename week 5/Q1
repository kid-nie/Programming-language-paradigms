#include <iostream>
#include <string>
using namespace std;

enum Day {
        MONDAY=1, 
        TUESDAY,
        WEDNESDAY,
        THURSDAY,
        FRIDAY,
        SATURDAY,
        SUNDAY,
        
    };

void printDayMessage(Day d) {
    if (d>=MONDAY&&d<=FRIDAY){
        cout<<"Time to work!"<<endl;
    }
    else if(d==SATURDAY){
        cout<<"Enjoy the weekend!"<<endl;
        
    }else{
        cout<<"Relax, it's Sunday!"<<endl;}
    
}

int main() {
    int choice;
    
    cout<<"Pick a number from 1-7: ";
    cin>>choice;
    
   if (choice>=1&&choice<=7){
   printDayMessage((Day)choice);
   }else
   {cout<<"Invalid input!"<<endl;}
    

}
