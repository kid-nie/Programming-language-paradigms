//2. Create a simple class called Rectangle with private data members and public methods. Add two private data members: width and height (both float).
//Implement the following public methods:
//a. setDimensions(float w, float h): Sets the width and height.
//b. getArea(): Returns the area of the rectangle.
//c. getPerimeter(): Returns the perimeter of the rectangle.
//In main(), create a Rectangle object, set its dimensions, and display the area
//and perimeter.
#include <iostream>
using namespace std;

class  Rectangle{       // The class
  private:             // Access specifier
    float width;        // Attribute (int variable)
    float height;  // Attribute (string variable)
    public:              // Access specifier
    void setDimensions(float w, float h) {  // Method/function 
      width=w;
      height=h;
    }
    void getArea() {  
        float a=width*height;
      cout << "area of rectangle is "<<a<<endl;
    }
    void getPerimeter() {  // Method/function 
      float p=2*(width+height);
      cout << "perimeter of rectangle is "<<p<<endl;
    }
};
class Square: public Rectangle{
    private:             // Access specifier
    float side;
    
    public:              // Access specifier
    void setDimensions_sq(float a) {  // Method/function 
      side=a;
    }
    void getArea_sq() {  
        float area=side*side;
      cout << "area of square is "<<area<<endl;
    }
    void getPerimeter_sq() {  // Method/function 
      float peri=4*side;
      cout << "perimeter of square is "<<peri<<endl;
    }
};
class Circle: public Rectangle{
    private:             // Access specifier
    float radius;
    
    public:              // Access specifier
    void rad(float r) {  // Method/function 
      radius=r;
    }
    void area() {  
        float area_cir=3.1415*radius*radius;
      cout << "area of circle is "<<area_cir<<endl;
    }
    void circumference() {  // Method/function 
      float circum=3.1415*radius*2;
      cout << "circumference of circle is "<<circum<<endl;
    }
};


int main() {
    float x,y;
    x=10;
    y=9.34;
    Rectangle rec;     // Create an object of MyClass
    rec.setDimensions(x,y);
    rec.getArea();
    rec.getPerimeter();
    
    Square square;
    square.setDimensions_sq(40);
    square.getArea_sq();
    square.getPerimeter_sq();
    
    Circle cir;
    cir.rad(5);
    cir.area();
    cir.circumference();
}
