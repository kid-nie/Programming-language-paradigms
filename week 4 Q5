
//5. Write a program that allocates memory for a string (character array) using
//malloc(), reads a string from the user, prints the entered string and frees the
//allocated memory.

#include <cstdlib>
#include<iostream>
using namespace std;

int main() {
    int n;
    cout << "Enter array length  : ";
    cin >> n;
    char *ptr;
    ptr= (char*)malloc(sizeof(char)*n);
    for(int i=0;i<n;i++){
        cout << "Enter array elements  : ";  
        cin >> *(ptr+i);
        
    }
    for (int i=0;i<n;i++){
        cout<<*(ptr+i)<<endl;
    }
    free(ptr);
}
