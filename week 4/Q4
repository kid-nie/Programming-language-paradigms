//4. Write a program that asks the user for a number n, uses malloc() to allocate an
//array of n integers, takes n integer inputs from the user and stores them in the
//array, prints the entered numbers, then frees the allocated memory

#include <cstdlib>
#include<iostream>
using namespace std;

int main() {
    int n;
    cout << "Enter array length  : ";
    cin >> n;
    int *ptr;
    ptr= (int*)malloc(sizeof(int)*n);
    for(int i=0;i<n;i++){
        cout << "Enter array elements  : ";  
        cin >> *(ptr+i);
        
    }
    for (int i=0;i<n;i++){
        cout<<*(ptr+i)<<endl;
    }
    free(ptr);
}
