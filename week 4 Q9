//9. A map maps a key to a value. Write a program where hypothetical student IDs are mapped to a name.
#include <iostream>
#include <map>
using namespace std;

int main() {
    map<int, string> people = {};
    string name;
    int id;
    cout<<"Enter name: ";
    cin >> name;
    cout<<"Enter id: ";
    cin >> id;
    
    people[id] = name;
    cout << id<<" ID belongs to " << people[id] << "\n";
    return 0;
}
