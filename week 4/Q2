//Write a program that declares a character array (string), uses a pointer to iterate
//over the string without using array indexing, and prints each character using
//pointer dereferencing and increments the pointer.


#include<iostream>
using namespace std;

int main() {
    char arr[] ="hello" ;
    char* ptr= &arr[0];
    cout <<"Elements of the array using arr[i]:" << endl;
    for (int i = 0; i < 5; i++) {
        cout << arr[i] <<""<<endl;
    }
    cout <<"\nElements of the array using pointer:" << endl;
    for (int i = 0; i < 5; i++) {
        cout << *(ptr+i) <<""<<endl;
    }
return 0;
}
