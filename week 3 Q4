//4. Explore how function parameters are local to the function: Write a function that
//takes an integer parameter and modifies its value inside the function. Print the
//value inside the function. Print the original value in main() and observe changes.

#include <iostream>
using namespace std;

int x=2006; 

int changenum_function(int x){
    x=16;
    return x;
}

void changeval_function(int a){
    a=16;
    cout<<"3.function with void:" <<a<<endl;
}

int main() {
    cout<<"1. outside function: "<<x<<endl;
    cout<<"2. using function without void: "<< changenum_function(x)<<endl;
    changeval_function(x);
}
