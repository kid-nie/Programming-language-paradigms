//9. A map maps a key to a value. Write a program where hypothetical student IDs are mapped to a name.
#include <iostream>
#include <map>
using namespace std;

int main() {
    int num;
    cout<<"Enter no.of students: ";
    cin >> num;
    map<int, string> people = {};
    string name;
    int id;
    for (int i=0;i<num;i++){
    cout<<"Enter name: ";
    cin >> name;
    cout<<"Enter id: ";
    cin >> id;
    
    people[id] = name;
    }
    cout << "ID\t\t\t NAME" << endl;
    for (auto i : people)
        cout << i.first << " \t\t\t " << i.second << endl;
}
