#include <iostream>
using namespace std;

int main() {
    cout<<"5. Write a program to declare two integers and demonstrate the use of addition,subtraction, multiplication, division and modulo operators"<<endl;
    
    int num;
    cout<<"type your number:";
    cin >>num;
    
    int num2;
    cout<<"type your number:";
    cin >>num2;
    
    int sum=num+num2;
    int sub=num-num2;
    int mul=num*num2;
    float dive=num/num2;
    
    cout<<"sum of the two numbers is "<<sum <<"\n";
    cout<<"subtraction of the two numbers is "<<sub<<"\n";
    cout<<"product of the two numbers is "<<mul<<"\n";
    cout<<"quotient of the two numbers is "<<dive<<"\n";
}
