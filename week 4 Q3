//3. Write a program that allocates memory for an integer using malloc(), stores a
//user-provided value in the allocated memory, prints the stored value and frees
//the allocated memory.

#include <cstdlib>
#include<iostream>
using namespace std;

int main() {
    int var_len = 5;
  int *ptr = (int*) malloc(sizeof(int)*var_len);    
  for(int i=0;i<var_len;i++)  
  {  
      cout << "Enter a number : " << endl;  
      cin >> *(ptr+i);  
  }  
  cout << "Entered elements are : " << endl;  
   for(int i=0;i<var_len;i++)  
  {  
     cout << *(ptr+i) << endl;  
  }  
free(ptr); 
}
