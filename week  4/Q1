//1. Write a program that declares an integer array with 5 elements, uses a pointer to
//traverse the array and print each element, and uses pointer arithmetic (ptr + i)
//instead of array indexing (arr[i]).


#include<iostream>
using namespace std;

int main() {
    int arr[5] = { 10,20,30,40,50 } ;
    int* ptr = arr;
    // Pointing to the first element of the array
    cout <<"Elements of the array using arr[i]:" << endl;
    for (int i = 0; i < 5; i++) {
        cout << arr[i] <<""<<endl;
    }
    cout <<"\nElements of the array using pointer:" << endl;
    for (int i = 0; i < 5; i++) {
        cout << *(ptr+i) <<""<<endl;
    }
return 0;
}
